# Copy values into your hosting provider's secret/environment settings.
# Never put .env, account data or payment secrets in GitHub.
SITE_DOMAIN=syolana.com
PUBLIC_ORIGIN=https://syolana.com
DATA_DIR=/data
# Set only when the application port is private behind the supplied reverse proxy.
TRUST_PRIVATE_PROXY=1
# Open only after publishing actual operator details, terms and privacy policy.
REGISTRATION_OPEN=0
TERMS_VERSION=replace-with-your-final-terms-version
LEGAL_READY=0
# Payments default to OFF. No automatic card debits are implemented.
PAYMENTS_ENABLED=0
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
ALLOW_TEST_PAYMENTS=0
CURRENT_PRICE_KOPECKS=100000
# Choose these with your accountant/payment provider; do not guess tax settings.
RECEIPT_VAT_CODE=
RECEIPT_TAX_SYSTEM_CODE=
RECEIPT_PAYMENT_MODE=

# npd: self-employed My Tax receipts; kkt: company/IP receipt settings above.
TAX_MODE=npd
# Set to 1 only after agreeing how every paid order gets its My Tax receipt.
# This implementation does not register NPD income automatically.
NPD_RECEIPTS_CONFIRMED=0
